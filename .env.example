# =============================================================================
# GestorProyectos Docker Compose Configuration
# Copy this file to .env and customize for your environment
# =============================================================================

# PostgreSQL Configuration
# Default credentials for local development only
POSTGRES_USER=gestor
POSTGRES_PASSWORD=password
POSTGRES_DB=gestor_proyectos
POSTGRES_PORT=5432

# Backend Configuration
# DATABASE_URL is auto-generated from POSTGRES_* variables in docker-compose.yml
# Override here only if using external database
# DATABASE_URL=postgresql+asyncpg://gestor:password@postgres:5432/gestor_proyectos
JWT_SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Optional: Seed Data Loading
# Set to true to load example data from CSV files on first startup
SEED_DATA=false
