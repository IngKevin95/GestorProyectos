    {
      "name": "GET /projects?estado=Activo - Filter by estado (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('All returned projects have estado=Activo', function() {",
              "  const jsonData = pm.response.json();",
              "  jsonData.data.forEach(function(project) {",
              "    pm.expect(project.status).to.equal('Activo');",
              "  });",
              "});"
            ]
          }
        }
      ],
