{
  "info": {
    "name": "EP-001 CRUD API Contracts",
    "description": "Contract tests for Projects CRUD endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /projects - Create (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function() {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has id, nombre, responsable, estado, prioridad, tipo_proyecto', function() {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.have.property('id');",
              "  pm.expect(jsonData).to.have.property('name');",
              "  pm.expect(jsonData).to.have.property('responsable');",
              "  pm.expect(jsonData).to.have.property('status');",
              "  pm.expect(jsonData).to.have.property('prioridad');",
              "  pm.expect(jsonData).to.have.property('tipo_proyecto');",
              "});",
              "pm.test('responsable is not empty', function() {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.responsable).not.to.be.empty;",
              "});",
              "pm.test('estado is in enum', function() {",
              "  const jsonData = pm.response.json();",
              "  const validStates = ['Activo', 'En Pausa', 'Cancelado', 'Completado'];",
              "  pm.expect(validStates).to.include(jsonData.status);",
              "});",
              "if (pm.response.code === 201) {",
              "  const jsonData = pm.response.json();",
              "  pm.collectionVariables.set('project_id', jsonData.id);",
              "  pm.collectionVariables.set('project_version', jsonData.version);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"responsable\": \"Alice\", \"estado\": \"Activo\", \"prioridad\": \"Alta\", \"fecha_limite\": \"2026-12-31\", \"siguiente_paso\": \"Revisar brief\", \"bloqueos\": \"Pendiente aprobaci\\u00f3n\", \"notas\": \"Test\", \"tipo_proyecto\": \"Diagn\\u00f3stico\", \"name\": \"Proyecto Test\", \"total_effort\": 100}"
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/projects",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "projects"
          ]
        }
      }
    },
