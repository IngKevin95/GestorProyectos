              "});",
              "pm.test('Response is array', function() {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/api/v1/projects",
          "protocol": "http",
          "host": [
            "localhost"
